# Frontend dev-only overrides. Vite loads this directory as its env root, so `VITE_*` entries
# must live here — a copy in the repository-root `.env` is never read.
#
# Turns on MSW for login/management mocks. Only takes effect with `pnpm dev`; production builds
# ignore it (see `enableMocking` in src/main.ts).
VITE_API_MOCKING=false
