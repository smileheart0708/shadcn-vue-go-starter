# Backend runtime
PORT=8080
DATA_DIR=.data
API_REQUEST_LOG_ENABLED=false

# JWT signing secret (optional first-run seed)
# The database value always wins. Minimum 32 characters when set.
# Leave blank to generate a random secret if the database holds none.
JWT_SECRET=

# Session lifetimes
JWT_TTL=10m
REFRESH_IDLE_TTL=168h
REFRESH_ABSOLUTE_TTL=720h
REFRESH_COOKIE_NAME=

# Frontend dev mock toggle
VITE_API_MOCKING=false
